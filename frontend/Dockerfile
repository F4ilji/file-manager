# Используем официальный образ Node.js
FROM node:20-alpine

# Устанавливаем рабочую директорию. Node.js создаст ее, если она не существует.
WORKDIR /app

# Копируем файлы манифеста зависимостей
# Используем `*` чтобы скопировать и package.json, и package-lock.json
COPY package*.json ./

# Устанавливаем зависимости.
# На этом этапе все файлы создаются от имени root
RUN npm install

# Копируем все остальные файлы нашего приложения
COPY . .

# === КЛЮЧЕВОЕ РЕШЕНИЕ ПРОБЛЕМЫ С ПРАВАМИ ===
# Меняем владельца всех файлов в /app на пользователя `node`
# Делаем это ДО того, как переключимся на этого пользователя
RUN chown -R node:node /app

# Теперь переключаемся на непривилегированного пользователя
USER node

# Открываем порт для Vite
EXPOSE 5173

# Команда для запуска. Теперь она ТОЛЬКО запускает сервер.
# Используем формат exec-массива, это более надежно.
# `-- --host` необходимо, чтобы Vite слушал все сетевые интерфейсы внутри контейнера.
#CMD ["npm", "run", "dev", "--", "--host"]